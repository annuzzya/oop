<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:Task_5.Models"
             xmlns:vm="clr-namespace:Task_5.ViewModels"
             x:Class="Task_5.MainPage"
             x:DataType="vm:MainViewModel"
             Title="Каталог товарів">

    <Grid RowDefinitions="*, Auto" Padding="10" RowSpacing="10">

        <!-- Список товарів -->
        <CollectionView Grid.Row="0"
                        ItemsSource="{Binding Products}"
                        SelectedItem="{Binding SelectedProduct}"
                        SelectionMode="Single">
            <CollectionView.ItemTemplate>
                <DataTemplate x:DataType="models:Product">
                    <!-- Рамка навколо кожного товару -->
                    <Frame Padding="10" Margin="0,5" CornerRadius="5" BorderColor="LightGray">
                        <Grid RowDefinitions="Auto, Auto" ColumnDefinitions="*, Auto" RowSpacing="5">
                            <!-- Назва -->
                            <Label Grid.Row="0" Grid.Column="0" Text="{Binding Name}" FontSize="18" FontAttributes="Bold" />
                            <!-- Ціна -->
                            <Label Grid.Row="0" Grid.Column="1" Text="{Binding Price, StringFormat='{0:F2} ₴'}" FontSize="18" TextColor="Green" />
                            <!-- Опис та інфо -->
                            <Label Grid.Row="1" Grid.Column="0" Grid.ColumnSpan="2" Text="{Binding DisplayInfo}" FontSize="14" TextColor="Gray" />
                        </Grid>
                    </Frame>
                </DataTemplate>
            </CollectionView.ItemTemplate>
        </CollectionView>

        <!-- Кнопки знизу -->
        <HorizontalStackLayout Grid.Row="1" Spacing="10" HorizontalOptions="Center">
            <Button Text="Додати книгу" 
                    Command="{Binding AddProductCommand}"
                    BackgroundColor="#2196F3"
                    TextColor="White"/>

            <Button Text="Видалити обране" 
                    Command="{Binding RemoveProductCommand}"
                    BackgroundColor="#F44336"
                    TextColor="White"/>
        </HorizontalStackLayout>

    </Grid>

</ContentPage>